{
  "name": "t-store",
  "version": "1.0.0",
  "description": "Terminal Command Store - Save and run commands with aliases",
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "bin": {
    "tstore": "./bin/tstore"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "terminal",
    "command",
    "store",
    "alias",
    "shell",
    "productivity"
  ],
  "author": "Vishwa Prasad <vishwaprasad11@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vp21-sudo/t-store.git"
  },
  "bugs": {
    "url": "https://github.com/vp21-sudo/t-store/issues"
  },
  "homepage": "https://github.com/vp21-sudo/t-store#readme",
  "private": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:binary": "bun build --compile src/index.ts --outfile tstore",
    "prepublishOnly": "npm run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "prompts": "^2.4.2"
